PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/barber_booking
JWT_SECRET=super-secret-jwt-key-for-level-1-development-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ==========================================
# Google Firebase Free Phone Auth (Backend Verification)
# ==========================================
FIREBASE_PROJECT_ID=your_firebase_project_id

# ==========================================
# Real SMS Gateway Options (Optional)
# ==========================================
# Option 1: Fast2SMS (India Bulk SMS / OTP)
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
# FAST2SMS_ROUTE=q

# Option 2: Twilio (Global SMS)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# Real Email OTP Service (SMTP / Nodemailer)
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_email_app_password
# EMAIL_FROM="Local's Cut Studio" <your_email@gmail.com>
